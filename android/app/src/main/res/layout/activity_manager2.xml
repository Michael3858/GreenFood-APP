<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE4E1"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".manager2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="left"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@drawable/back" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="請輸入要新增的餐廳資訊:"
            android:textColor="#444444"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_gravity="left"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/nameET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="請輸入名稱"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>


        <Spinner
            android:id="@+id/spinner1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <Spinner
            android:id="@+id/spinner2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/addressET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="請輸入地址"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/phoneET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="請輸入電話號碼"
            android:inputType="phone"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <Spinner
            android:id="@+id/spinner3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/businesshoursET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="請輸入營業時間"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <Spinner
            android:id="@+id/spinner4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <Spinner
            android:id="@+id/spinner5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <Spinner
            android:id="@+id/spinner6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <Spinner
            android:id="@+id/spinner7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/urlET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="請輸入google map網址"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/fanpageET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="請輸入粉絲專頁網址"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/picurlET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="請輸入餐廳照片網址"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="確定新增"
            android:textSize="20dp"
            android:backgroundTint="#DEB887"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
